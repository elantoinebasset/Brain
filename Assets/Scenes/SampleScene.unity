--- !u!114 &1100469410
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1100469409}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 57a4eb800cb38414da9ad847f29b4d8f, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::BrainVR.TextSequence
  panel: {fileID: 602422709}
  textField: {fileID: 1491373446}
  startDelay: 2
  autoAdvance: 1
  hideWhenFinished: 1
  groups:
  - title: Bienvenue dans le cerveau !
    text: "Le cerveau est un organe essentiel du syst\xE8me nerveux central, situ\xE9
      dans la bo\xEEte cr\xE2nienne.\n\nIl est compos\xE9 de milliards de neurones
      qui communiquent entre eux gr\xE2ce \xE0 des signaux \xE9lectriques et chimiques."
    wordInterval: 0.12
    delayAfter: 5
  - title: 
    text: "Divis\xE9 en plusieurs parties, dont les principales sont le cerveau,
      le cervelet et le tronc c\xE9r\xE9bral, il assure le contr\xF4le des mouvements
      volontaires, la m\xE9moire, le langage, les \xE9motions, les sensations et
      les fonctions vitales comme la respiration et le rythme cardiaque."
    wordInterval: 0.12
    delayAfter: 5
  - title: 
    text: "Vous allez d\xE9sormais consommer une certaine quantit\xE9 de cannabis
      . Celui-ci contient une mol\xE9cule psychoactive appel\xE9e **THC**, ou **t\xE9trahydrocannabinol**.
      Vous allez absorber **49 mg** de cette substance l\u2019\xE9quivalent d\u2019environ
      un joint. Puis vous passerez \xE0 **490 mg**, l\u2019\xE9quivalent de 10 joints."
    wordInterval: 0.12
    delayAfter: 6
  onGroupStarted:
    m_PersistentCalls:
      m_Calls: []
  onSequenceFinished:
    m_PersistentCalls:
      m_Calls: []
